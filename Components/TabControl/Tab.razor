@inherits CustomComponent

<div class="grow bg-blue-300 flex-col @(Parent?.ActiveIndex == Index ? "flex" : "hidden")">
    @ChildContent
</div>

@code {

    [Parameter]
    public string Title { get; set; } = "---";

    [CascadingParameter]
    public TabPanel? Parent { get; set; } = null!;

    public int Index = 0;

    protected override void OnInitialized()
    {
        Parent?.RegisterTab(this);
    }
}
